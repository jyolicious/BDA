# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=cyber_threat_intelligence
MONGO_COLLECTION_ALERTS=threat_alerts
MONGO_COLLECTION_EVENTS=streaming_events

# HDFS Configuration
HDFS_URL=http://localhost:9870
HDFS_USER=hadoop
HDFS_ROOT_DIR=/cyber-threat
HDFS_USE_EMULATED_FALLBACK=true

# Spark Configuration
SPARK_APP_NAME=CyberThreatIntelligence
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g

# Streaming & Pipeline
STREAMING_BATCH_INTERVAL_SEC=1
SLIDING_WINDOW_MINUTES=5
BLOOM_CAPACITY=1000000
BLOOM_ERROR_RATE=0.01
